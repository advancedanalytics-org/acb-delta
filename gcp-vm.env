# Copy to .env and replace every CHANGEME. Never commit .env.
# Passwords are placed into connection URLs unencoded: use letters and digits only
# (e.g. `openssl rand -hex 16`), not base64 (/ + = break the URLs).
# Phase 1 → Phase 2 (GreenNode) is a change of these values only.

# --- Postgres + pgvector (Phase 2: vDB PostgreSQL) ---
POSTGRES_USER=acb
POSTGRES_PASSWORD=d2db43779f154d7bb961d481522f5a9f
POSTGRES_DB=acb_delta
# Set to use an external DB instead of the postgres container (Phase 2).
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/acb_delta

# --- Object storage, S3-compatible (Phase 1: MinIO, Phase 2: vStorage) ---
MINIO_ROOT_USER=acb
MINIO_ROOT_PASSWORD=3f2fd621dd91e5053e3b26791dbdfe1a
S3_BUCKET=documents

# --- LLM, OpenAI-compatible (Phase 2: GreenNode MaaS). Empty = agent /invoke returns 503. ---
OPENAI_BASE_URL=
OPENAI_API_KEY=
LLM_MODEL=
# json_schema, or function_calling if the provider rejects JSON-schema structured output.
LLM_STRUCTURED_METHOD=json_schema
# Per-run caps on LLM calls: changes kept from a VBPL, internal passages judged per change.
MAX_CHANGES=10
RETRIEVE_K=5

# --- Embeddings (model not chosen yet, see MINH-01) ---
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=

# --- Langfuse Cloud tracing. Empty keys = tracing off. ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Frontend: mock (demo data) or live (backend APIs). Rebuild after changing. ---
VITE_API_MODE=mock

# --- Host ports (Postgres and MinIO bind to 127.0.0.1 only) ---
FRONTEND_PORT=3000
API_PORT=8000
AGENT_PORT=8080
POSTGRES_PORT=5432
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Public access, written by scripts/gcp.sh
SITE_ADDRESS=34-143-129-52.sslip.io
BASIC_AUTH_USER=acb
BASIC_AUTH_PASSWORD=87ed7bbe8bf03ecee730aad0
BASIC_AUTH_HASH='$2a$14$qeWuwhfRp9DUXHA9UaEOfO38WqqNoSIJGbgnsfvDIQWmXI2utTBQC'
COMPOSE_FILE=docker-compose.yml:deploy/gcp/docker-compose.gcp.yml
MODEL_API_KEY=98745941c089de5fae1a4a9f9a7eadc83cd8e3600fe1370f
