# Copy to .env and replace every CHANGEME. Never commit .env.
# Passwords are placed into connection URLs unencoded: use letters and digits only
# (e.g. `openssl rand -hex 16`), not base64 (/ + = break the URLs).
# Phase 1 → Phase 2 (GreenNode) is a change of these values only.

# --- Postgres + pgvector (Phase 2: vDB PostgreSQL) ---
POSTGRES_USER=acb
POSTGRES_PASSWORD=CHANGEME
POSTGRES_DB=acb_delta
# Set to use an external DB instead of the postgres container (Phase 2).
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/acb_delta

# --- Object storage, S3-compatible (Phase 1: MinIO, Phase 2: vStorage) ---
MINIO_ROOT_USER=acb
MINIO_ROOT_PASSWORD=CHANGEME
S3_BUCKET=documents

# --- Agent (Phase 1: compose container, Phase 2: GreenNode AgentBase Runtime) ---
# Empty = the compose `agent` service. On AgentBase: the Runtime's endpoint URL.
# AGENT_URL=
# IAM Service Account allowed to invoke the Runtime ("IAM Permissions" inbound auth).
# Empty = no Authorization header.
AGENTBASE_CLIENT_ID=
AGENTBASE_CLIENT_SECRET=

# --- LLM provider: "gemini" (langchain_google_genai) or "openai" (langchain_openai) ---
LLM_TYPE=openai
OPENAI_BASE_URL=
OPENAI_API_KEY=
LLM_MODEL=
GEMINI_API_KEY=
GOOGLE_API_KEY=
# json_schema, or function_calling if the provider rejects JSON-schema structured output.
LLM_STRUCTURED_METHOD=json_schema
# Per-run caps on LLM calls: changes kept from a VBPL, internal passages judged per change.
MAX_CHANGES=10
RETRIEVE_K=5
# API impact analysis only: JSON merged into chat requests, and parallel LLM calls.
# On OpenRouter, Qwen3 is ~5x faster without thinking:
# LLM_EXTRA_BODY='{"reasoning":{"enabled":false}}'
LLM_EXTRA_BODY=
LLM_CONCURRENCY=4
# Parallel agent /draft calls per RIA review package (POST /api/analyses/{job_id}/review).
REVIEW_DRAFT_CONCURRENCY=4
# Build the review package (agent drafts) right after each analysis; the UI reads it.
REVIEW_AUTO_START=true

# --- Embeddings (model not chosen yet, see MINH-01). Empty = sparse retrieval only. ---
# Must return 1024-dim vectors (index_view.embedding is vector(1024)).
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=

# --- Reranker for impact analysis (Cohere/Jina-style POST {base}/rerank). Empty = lexical/dense
# relevance gate. OpenRouter example: RERANK_BASE_URL=https://openrouter.ai/api/v1,
# RERANK_MODEL=qwen/qwen3-reranker-8b, RERANK_API_KEY=<same key as OPENAI_API_KEY>. ---
RERANK_BASE_URL=
RERANK_MODEL=
RERANK_API_KEY=

# --- TypeSafe Jev decisions model (OpenRouter Decisions API). Used as the Engine 1 reranker when
# RERANK_BACKEND=jev. Empty = not used.
# OpenRouter: JEV_BASE_URL=https://openrouter.ai/api/alpha, JEV_MODEL=typesafe/jev-1.14,
# JEV_API_KEY=<same key as OPENAI_API_KEY>. ---
JEV_BASE_URL=
JEV_MODEL=
JEV_API_KEY=
# jev | rerank (the RERANK_* cross-encoder above)
RERANK_BACKEND=rerank

# --- Langfuse Cloud tracing. Empty keys = tracing off. ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Frontend: mock (demo data) or live (backend APIs). Rebuild after changing. ---
VITE_API_MODE=live

# --- Host ports (Postgres and MinIO bind to 127.0.0.1 only) ---
FRONTEND_PORT=3000
API_PORT=8000
AGENT_PORT=8080
POSTGRES_PORT=5432
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
FALKORDB_PORT=6379
